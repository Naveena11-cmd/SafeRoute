# Copy this file to .env and fill in real values for anything beyond
# local dev. None of these are required to run `manage.py runserver`
# locally — every one has a safe default for local development.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Set to "false" for staging/production.
DJANGO_DEBUG=true

# Comma-separated hostnames, e.g. api.example.com,example.com
# Required when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=

# Comma-separated origins allowed to call the API via CORS, e.g.
# https://app.example.com. Only used when DJANGO_DEBUG=false; in dev
# every origin is allowed automatically.
DJANGO_CORS_ALLOWED_ORIGINS=

# Override if self-hosting OSRM instead of the public demo server.
OSRM_BASE_URL=https://router.project-osrm.org

# OpenStreetMap Overpass API (streetlights, sidewalks, police posts).
# The public instance below is fine for dev; self-host if you outgrow
# its rate limits.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_REQUEST_TIMEOUT_SECONDS=12
OSM_CACHE_TTL_SECONDS=86400

# Real incident/crime dataset — local path or http(s) URL (e.g. a city
# open-data portal CSV/JSON export). Leave blank to use the bundled
# core/data.csv baseline. If set but unreachable/unparseable, ingestion
# automatically falls back to core/data.csv.
INCIDENT_DATA_SOURCE=
